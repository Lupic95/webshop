    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/partials/header.css">
    <title>Document</title>
</head>
<body>
    
    <div id = "topwrapper">
        <a class ="label" href = "/paypal">PayPal</a>
        <a class ="label" href = "/retoure">Retoure</a>
        <a class ="label" href = "/newsletter">Newsletter</a>
        <a class ="label" href = "/hilfe">Hilfe & Kontakt</a>
    </div>
    <div id = "suche">
        <a id = "logo">Webshop</a>
        
        <input type = "text" id = "inputSuche" placeholder = "suche">
        <button id = "button_suche">Suchen</button>
        
        <button id = "login">Konto</button>
        <button>Warenkorb</button>
        <button id = "button_darkmode">Darkmode</button>
    </div>
    <div id = "searchResults">

    </div>
    <div id = "loginContainer">
        <div style = "width:100%;height:20%;background-color: gray;text-align: center;"><h1>Login</h1></div>
        <div style = "display:flex; width:100%;height:50%; flex-wrap: wrap;  justify-content: space-between;">
            <a>Benuter:</a> <input placeholder="mail@provider.com" type="email"> <br>
            <a>Passwort:</a> <input placeholder="Passwort" type= "password">
            <button>Login</button> <button>Abbrechen</button>
        </div>
        <div style = "width:100%; height:30%">
            <a>Noch keinen Account ? </a> <a href = "/">Registriere </a> <a>dich hier</a>
        </div>
        
        
    </div>
    <script>
        const login_button = document.getElementById("login")
        const loginContainer = document.getElementById("loginContainer")
        loginContainer.style.display = "none"
        login_button.addEventListener("click", function (){
            console.log(loginContainer.style.display)
            
            if (loginContainer.style.display == "none"){
                loginContainer.style.display = "block"
            } else {
                loginContainer.style.display = "none"
            }
        })
        
       
    </script>
    <script src ="../../js/fetchSearchData.js"></script>
 </body>
